# Rendered at container start by the nginx image's envsubst step into
# /etc/nginx/conf.d/default.conf. Only defined environment variables
# (API_UPSTREAM) are substituted; nginx's own $variables are left alone.
#
# Same-origin contract: the SPA calls relative /api/* and /health/* paths.
# Those are proxied, path unchanged, to the API Service; everything else is
# static assets with an index.html fallback for client-side routes.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    # Frontend-only probe; does not depend on the API being ready.
    location = /frontend-healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    location /health/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_read_timeout 10s;
    }

    # Hashed build assets: cache aggressively, never fall back to index.html.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
