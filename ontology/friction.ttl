@prefix fd:   <https://haikei.dev/ontology/friction#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:  <http://purl.org/dc/terms/> .

# Conference Friction Desk vocabulary.
# Source of truth for concept tagging; ontology/compile.py projects it into
# ontology/build/concepts.json and ontology/build/synonyms.json.
# Concepts describe facilities, services and problems -- never attributes of
# individual people (no health, religion or identity inference).

fd:FrictionScheme a skos:ConceptScheme ;
    dct:title "Conference attendee friction"@en ;
    skos:hasTopConcept fd:Venue , fd:Accessibility , fd:Schedule , fd:Connectivity ,
        fd:FoodAndBeverage , fd:Registration , fd:Content , fd:SafetyAndConduct ,
        fd:Transport , fd:SponsorsAndExpo , fd:Comfort .

#################################################################### Venue

fd:Venue a skos:Concept ; skos:inScheme fd:FrictionScheme ; skos:topConceptOf fd:FrictionScheme ;
    skos:prefLabel "Venue"@en ;
    skos:altLabel "building"@en , "facility"@en , "conference center"@en , "convention center"@en ;
    skos:definition "Problems with the physical building: rooms, signage, crowding, climate, restrooms and seating."@en .

fd:Wayfinding a skos:Concept ; skos:inScheme fd:FrictionScheme ; skos:broader fd:Venue ;
    skos:prefLabel "Wayfinding"@en ;
    skos:altLabel "getting lost"@en , "navigation"@en , "got lost"@en , "get lost"@en , "can't find my way"@en , "couldn't find my way"@en , "hard to navigate"@en , "indoor directions"@en ;
    skos:definition "Difficulty finding rooms, halls or services inside the venue."@en .

fd:MissingSignage a skos:Concept ; skos:inScheme fd:FrictionScheme ; skos:broader fd:Wayfinding ;
    skos:prefLabel "Missing signage"@en ;
    skos:altLabel "no signs"@en , "no signage"@en , "signs missing"@en , "unsigned"@en , "zero signage"@en , "no directional signs"@en , "nothing is labeled"@en , "nothing labeled"@en , "no room numbers"@en , "unlabeled rooms"@en ;
    skos:definition "Signs pointing to rooms or services are absent."@en .

fd:ConfusingSignage a skos:Concept ; skos:inScheme fd:FrictionScheme ; skos:broader fd:Wayfinding ;
    skos:prefLabel "Confusing signage"@en ;
    skos:altLabel "wrong signs"@en , "misleading signs"@en , "signage confusing"@en , "signs point wrong way"@en , "confusing signs"@en , "direction signs"@en , "signs don't match"@en , "room names don't match"@en ;
    skos:definition "Signs exist but are wrong, contradictory or hard to follow."@en ;
    skos:related fd:LowContrastSignage .

fd:HardToFindRoom a skos:Concept ; skos:inScheme fd:FrictionScheme ; skos:broader fd:Wayfinding ;
    skos:prefLabel "Hard to find room"@en ;
    skos:altLabel "can't find room"@en , "cant find the room"@en , "where is room"@en , "room hidden"@en , "which floor"@en , "couldn't find the room"@en , "could not find the room"@en , "can't find the room"@en , "hard to find the room"@en , "find the right room"@en , "locate the room"@en ;
    skos:definition "A specific session room is hard to locate."@en ;
    skos:related fd:RoomChange .

fd:Crowding a skos:Concept ; skos:inScheme fd:FrictionScheme ; skos:broader fd:Venue ;
    skos:prefLabel "Crowding"@en ;
    skos:altLabel "crowded"@en , "packed"@en , "too many people"@en , "congestion"@en ;
    skos:definition "Too many people for the space available."@en .

fd:OvercrowdedHallway a skos:Concept ; skos:inScheme fd:FrictionScheme ; skos:broader fd:Crowding ;
    skos:prefLabel "Overcrowded hallway"@en ;
    skos:altLabel "hallway packed"@en , "corridor blocked"@en , "bottleneck"@en , "can't get through"@en , "foot traffic jam"@en ;
    skos:definition "Corridors or foyers are congested between sessions."@en .

fd:RoomOverCapacity a skos:Concept ; skos:inScheme fd:FrictionScheme ; skos:broader fd:Crowding ;
    skos:prefLabel "Room over capacity"@en ;
    skos:altLabel "room overflowing"@en , "standing room only"@en , "fire capacity"@en , "too small room"@en , "room too small"@en ;
    skos:definition "A session room holds more people than it was sized for."@en ;
    skos:related fd:TalkFull , fd:NotEnoughSeating .

fd:Temperature a skos:Concept ; skos:inScheme fd:FrictionScheme ; skos:broader fd:Venue ;
    skos:prefLabel "Temperature"@en ;
    skos:altLabel "climate"@en , "hvac"@en , "air conditioning"@en , "a/c"@en , "ac"@en , "heating"@en ;
    skos:definition "The room climate is uncomfortable."@en .

fd:RoomTooHot a skos:Concept ; skos:inScheme fd:FrictionScheme ; skos:broader fd:Temperature ;
    skos:prefLabel "Room too hot"@en ;
    skos:altLabel "too hot"@en , "stuffy"@en , "sweltering"@en , "no air"@en , "ac broken"@en , "boiling"@en , "sauna"@en , "too warm"@en , "roasting"@en , "overheated"@en , "ac can't keep up"@en , "air conditioning can't keep up"@en ;
    skos:definition "A room is too warm or poorly ventilated."@en .

fd:RoomTooCold a skos:Concept ; skos:inScheme fd:FrictionScheme ; skos:broader fd:Temperature ;
    skos:prefLabel "Room too cold"@en ;
    skos:altLabel "too cold"@en , "freezing"@en , "ac too high"@en , "chilly"@en , "frigid"@en , "like a fridge"@en , "walk-in fridge"@en , "arctic"@en , "ice cold"@en , "too chilly"@en ;
    skos:definition "A room is too cold."@en .

fd:Restrooms a skos:Concept ; skos:inScheme fd:FrictionScheme ; skos:broader fd:Venue ;
    skos:prefLabel "Restrooms"@en ;
    skos:altLabel "bathroom"@en , "toilets"@en , "washroom"@en , "restroom"@en , "loo"@en , "wc"@en ;
    skos:definition "Problems with restroom facilities."@en .

fd:RestroomQueue a skos:Concept ; skos:inScheme fd:FrictionScheme ; skos:broader fd:Restrooms ;
    skos:prefLabel "Restroom queue"@en ;
    skos:altLabel "bathroom line"@en , "toilet queue"@en , "restroom line"@en , "not enough bathrooms"@en ;
    skos:definition "Long waits to use the restrooms."@en .

fd:RestroomOutOfSupplies a skos:Concept ; skos:inScheme fd:FrictionScheme ; skos:broader fd:Restrooms ;
    skos:prefLabel "Restroom out of supplies"@en ;
    skos:altLabel "no toilet paper"@en , "no soap"@en , "no paper towels"@en , "dirty bathroom"@en , "restroom unclean"@en ;
    skos:definition "Restrooms lack supplies or are unclean."@en .

fd:RestroomOutOfOrder a skos:Concept ; skos:inScheme fd:FrictionScheme ; skos:broader fd:Restrooms ;
    skos:prefLabel "Restroom out of order"@en ;
    skos:altLabel "bathroom closed"@en , "toilet broken"@en , "flooded bathroom"@en , "restroom closed"@en ;
    skos:definition "A restroom is closed, broken or flooded."@en .

fd:Seating a skos:Concept ; skos:inScheme fd:FrictionScheme ; skos:broader fd:Venue ;
    skos:prefLabel "Seating"@en ;
    skos:altLabel "seats"@en , "chairs"@en ;
    skos:definition "Problems with seats in session rooms or common areas."@en .

fd:NotEnoughSeating a skos:Concept ; skos:inScheme fd:FrictionScheme ; skos:broader fd:Seating ;
    skos:prefLabel "Not enough seating"@en ;
    skos:altLabel "no seats"@en , "no chairs"@en , "nowhere to sit"@en , "had to stand"@en , "standing only"@en , "not enough chairs"@en , "not enough seats"@en , "no free chair"@en , "no free seats"@en , "sit on the floor"@en , "sitting on the floor"@en , "leaning on walls"@en ;
    skos:definition "There are too few seats for the people present."@en ;
    skos:related fd:ReservedSeatingMissing .

fd:UncomfortableSeating a skos:Concept ; skos:inScheme fd:FrictionScheme ; skos:broader fd:Seating ;
    skos:prefLabel "Uncomfortable seating"@en ;
    skos:altLabel "bad chairs"@en , "chairs too close"@en , "uncomfortable chairs"@en , "broken chair"@en ;
    skos:definition "Seats are broken, cramped or uncomfortable."@en .

fd:VenueNoise a skos:Concept ; skos:inScheme fd:FrictionScheme ; skos:broader fd:Venue ;
    skos:prefLabel "Venue noise"@en ;
    skos:altLabel "noisy room"@en , "sound bleed"@en , "loud next door"@en , "too loud"@en , "noise from hallway"@en , "thin walls"@en ;
    skos:definition "Noise from neighbouring rooms, hallways or building systems disrupts a space."@en ;
    skos:related fd:ExpoTooLoud , fd:CantHearSpeaker .

fd:Lighting a skos:Concept ; skos:inScheme fd:FrictionScheme ; skos:broader fd:Venue ;
    skos:prefLabel "Lighting"@en ;
    skos:altLabel "too dark"@en , "lights off"@en , "too bright"@en , "glare"@en , "lights flickering"@en ;
    skos:definition "Room lighting is too dark, too bright or faulty."@en ;
    skos:related fd:SlidesUnreadable .

#################################################################### Accessibility

fd:Accessibility a skos:Concept ; skos:inScheme fd:FrictionScheme ; skos:topConceptOf fd:FrictionScheme ;
    skos:prefLabel "Accessibility"@en ;
    skos:altLabel "a11y"@en , "accessible"@en , "ada"@en , "disability access"@en , "inclusive access"@en ;
    skos:definition "Barriers that prevent people from accessing spaces, sessions or information."@en .

fd:StepFreeAccess a skos:Concept ; skos:inScheme fd:FrictionScheme ; skos:broader fd:Accessibility ;
    skos:prefLabel "Step-free access"@en ;
    skos:altLabel "step free"@en , "wheelchair access"@en , "level access"@en , "stairs only"@en ;
    skos:definition "Routes that avoid stairs are missing or blocked."@en .

fd:BlockedAccessibleEntrance a skos:Concept ; skos:inScheme fd:FrictionScheme ; skos:broader fd:StepFreeAccess ;
    skos:prefLabel "Blocked accessible entrance"@en ;
    skos:altLabel "accessible entrance blocked"@en , "accessible door locked"@en , "wheelchair entrance blocked"@en , "ramp blocked"@en , "accessible door closed"@en ;
    skos:definition "The accessible entrance to a room or building is locked, obstructed or closed."@en ;
    skos:related fd:BlockedEmergencyExit .

fd:ElevatorOutOfService a skos:Concept ; skos:inScheme fd:FrictionScheme ; skos:broader fd:StepFreeAccess ;
    skos:prefLabel "Elevator out of service"@en ;
    skos:altLabel "elevator broken"@en , "lift broken"@en , "lift out of order"@en , "elevator down"@en , "escalator broken"@en , "elevator is out of service"@en , "elevator not working"@en , "lift not working"@en , "escalator out of service"@en , "elevator closed"@en ;
    skos:definition "An elevator or lift needed for step-free access is not working."@en .

fd:MissingRamp a skos:Concept ; skos:inScheme fd:FrictionScheme ; skos:broader fd:StepFreeAccess ;
    skos:prefLabel "Missing ramp"@en ;
    skos:altLabel "no ramp"@en , "stage not accessible"@en , "no ramp to stage"@en , "steps only"@en , "ramp missing"@en , "no wheelchair ramp"@en , "no alternative ramp"@en ;
    skos:definition "A stage, room or area has steps and no ramp."@en .

fd:HearingAccess a skos:Concept ; skos:inScheme fd:FrictionScheme ; skos:broader fd:Accessibility ;
    skos:prefLabel "Hearing access"@en ;
    skos:altLabel "deaf access"@en , "hard of hearing access"@en , "hearing accessibility"@en ;
    skos:definition "Sessions or announcements lack support for people who are deaf or hard of hearing."@en .

fd:MissingCaptions a skos:Concept ; skos:inScheme fd:FrictionScheme ; skos:broader fd:HearingAccess ;
    skos:prefLabel "Missing captions"@en ;
    skos:altLabel "no captions"@en , "no subtitles"@en , "cart missing"@en , "live captioning down"@en , "captions broken"@en , "no transcription"@en ;
    skos:definition "Live captions or transcription are absent or broken."@en ;
    skos:related fd:CantHearSpeaker .

fd:HearingLoopUnavailable a skos:Concept ; skos:inScheme fd:FrictionScheme ; skos:broader fd:HearingAccess ;
    skos:prefLabel "Hearing loop unavailable"@en ;
    skos:altLabel "no hearing loop"@en , "induction loop"@en , "t-coil"@en , "assistive listening"@en , "hearing loop broken"@en ;
    skos:definition "An induction loop or assistive listening system is missing or not working."@en .

fd:SignLanguageMissing a skos:Concept ; skos:inScheme fd:FrictionScheme ; skos:broader fd:HearingAccess ;
    skos:prefLabel "Sign language interpretation missing"@en ;
    skos:altLabel "no interpreter"@en , "asl"@en , "no sign language"@en , "interpreter missing"@en ;
    skos:definition "Requested sign language interpretation is not provided."@en .

fd:VisualAccess a skos:Concept ; skos:inScheme fd:FrictionScheme ; skos:broader fd:Accessibility ;
    skos:prefLabel "Visual access"@en ;
    skos:altLabel "low vision access"@en , "blind access"@en , "visual accessibility"@en ;
    skos:definition "Information is not accessible to people who are blind or have low vision."@en .

fd:LowContrastSignage a skos:Concept ; skos:inScheme fd:FrictionScheme ; skos:broader fd:VisualAccess ;
    skos:prefLabel "Low contrast signage"@en ;
    skos:altLabel "hard to read signs"@en , "tiny signs"@en , "small print signs"@en , "low contrast"@en ;
    skos:definition "Signs use small text or poor contrast."@en .

fd:NoScreenReaderSupport a skos:Concept ; skos:inScheme fd:FrictionScheme ; skos:broader fd:VisualAccess ;
    skos:prefLabel "No screen reader support"@en ;
    skos:altLabel "screen reader"@en , "app not accessible"@en , "voiceover broken"@en , "no alt text"@en ;
    skos:definition "Event app, site or materials do not work with screen readers."@en ;
    skos:related fd:AppScheduleWrong .

fd:SensoryAccess a skos:Concept ; skos:inScheme fd:FrictionScheme ; skos:broader fd:Accessibility ;
    skos:prefLabel "Sensory access"@en ;
    skos:altLabel "sensory friendly"@en , "neurodivergent access"@en , "overstimulation"@en ;
    skos:definition "Spaces lack options for reducing sensory load."@en .

fd:QuietRoomUnavailable a skos:Concept ; skos:inScheme fd:FrictionScheme ; skos:broader fd:SensoryAccess ;
    skos:prefLabel "Quiet room unavailable"@en ;
    skos:altLabel "no quiet room"@en , "quiet room closed"@en , "quiet space"@en , "quiet room full"@en , "decompression room"@en ;
    skos:definition "The designated quiet room is missing, closed, occupied for other uses or hard to find."@en ;
    skos:related fd:ExpoTooLoud , fd:VenueNoise .

fd:FlashingLights a skos:Concept ; skos:inScheme fd:FrictionScheme ; skos:broader fd:SensoryAccess ;
    skos:prefLabel "Flashing lights"@en ;
    skos:altLabel "strobe"@en , "strobe lights"@en , "flashing screen"@en , "flicker"@en ;
    skos:definition "Strobe or flashing effects are used without warning."@en ;
    skos:related fd:Lighting .

fd:MobilityAccess a skos:Concept ; skos:inScheme fd:FrictionScheme ; skos:broader fd:Accessibility ;
    skos:prefLabel "Mobility access"@en ;
    skos:altLabel "mobility"@en , "walking distance"@en , "mobility aid"@en ;
    skos:definition "Layout or services are hard to use for people with limited mobility."@en .

fd:LongWalkingDistances a skos:Concept ; skos:inScheme fd:FrictionScheme ; skos:broader fd:MobilityAccess ;
    skos:prefLabel "Long walking distances"@en ;
    skos:altLabel "too far to walk"@en , "rooms far apart"@en , "long walk"@en , "no time between sessions"@en ;
    skos:definition "Distances between rooms are too long to cover in the time allowed."@en ;
    skos:related fd:Wayfinding .

fd:ReservedSeatingMissing a skos:Concept ; skos:inScheme fd:FrictionScheme ; skos:broader fd:MobilityAccess , fd:Seating ;
    skos:prefLabel "Accessible seating missing"@en ;
    skos:altLabel "no wheelchair space"@en , "no accessible seating"@en , "reserved seating taken"@en , "no aisle seat"@en , "wheelchair spaces"@en , "wheelchair seating"@en , "accessible seating taken"@en , "accessible seating occupied"@en , "accessible seats taken"@en , "accessible seating"@en ;
    skos:definition "Reserved accessible seating or wheelchair spaces are missing or taken."@en .

#################################################################### Schedule

fd:Schedule a skos:Concept ; skos:inScheme fd:FrictionScheme ; skos:topConceptOf fd:FrictionScheme ;
    skos:prefLabel "Schedule"@en ;
    skos:altLabel "agenda"@en , "timetable"@en , "program"@en , "programme"@en , "sched"@en ;
    skos:definition "Problems with session timing, rooms or schedule information."@en .

fd:ScheduleChange a skos:Concept ; skos:inScheme fd:FrictionScheme ; skos:broader fd:Schedule ;
    skos:prefLabel "Schedule change"@en ;
    skos:altLabel "schedule changed"@en , "last minute change"@en , "agenda change"@en ;
    skos:definition "A session moved, changed time or was cancelled."@en .

fd:RoomChange a skos:Concept ; skos:inScheme fd:FrictionScheme ; skos:broader fd:ScheduleChange ;
    skos:prefLabel "Room change"@en ;
    skos:altLabel "room changed"@en , "session moved"@en , "talk moved"@en , "moved rooms"@en , "relocated"@en , "room moved"@en , "changed rooms"@en , "moved to another room"@en , "new room"@en ;
    skos:definition "A session was moved to a different room."@en ;
    skos:related fd:HardToFindRoom , fd:AppScheduleWrong .

fd:TimeChange a skos:Concept ; skos:inScheme fd:FrictionScheme ; skos:broader fd:ScheduleChange ;
    skos:prefLabel "Time change"@en ;
    skos:altLabel "time changed"@en , "rescheduled"@en , "moved earlier"@en , "moved later"@en ;
    skos:definition "A session was moved to a different time."@en .

fd:SessionCancelled a skos:Concept ; skos:inScheme fd:FrictionScheme ; skos:broader fd:ScheduleChange ;
    skos:prefLabel "Session cancelled"@en ;
    skos:altLabel "talk cancelled"@en , "canceled"@en , "cancelled"@en , "speaker no show"@en , "no-show"@en ;
    skos:definition "A session was cancelled or the speaker did not appear."@en .

fd:Timing a skos:Concept ; skos:inScheme fd:FrictionScheme ; skos:broader fd:Schedule ;
    skos:prefLabel "Session timing"@en ;
    skos:altLabel "timing"@en , "running late"@en , "behind schedule"@en ;
    skos:definition "Sessions do not start or end on time."@en .

fd:SessionOverrun a skos:Concept ; skos:inScheme fd:FrictionScheme ; skos:broader fd:Timing ;
    skos:prefLabel "Session overrun"@en ;
    skos:altLabel "overrun"@en , "ran over"@en , "went over time"@en , "ran long"@en , "overtime"@en ;
    skos:definition "A session ran past its scheduled end."@en .

fd:SessionStartedLate a skos:Concept ; skos:inScheme fd:FrictionScheme ; skos:broader fd:Timing ;
    skos:prefLabel "Session started late"@en ;
    skos:altLabel "started late"@en , "late start"@en , "delayed start"@en , "waiting for speaker"@en ;
    skos:definition "A session began after its scheduled start time."@en .

fd:ScheduleConflict a skos:Concept ; skos:inScheme fd:FrictionScheme ; skos:broader fd:Schedule ;
    skos:prefLabel "Schedule conflict"@en ;
    skos:altLabel "clash"@en , "overlap"@en , "conflict"@en ;
    skos:definition "Sessions or bookings collide in time or space."@en .

fd:DoubleBookedRoom a skos:Concept ; skos:inScheme fd:FrictionScheme ; skos:broader fd:ScheduleConflict ;
    skos:prefLabel "Double-booked room"@en ;
    skos:altLabel "double booked"@en , "double-booked"@en , "two talks same room"@en , "room conflict"@en , "room clash"@en , "double booking"@en , "same slot"@en , "booked twice"@en , "two sessions same room"@en ;
    skos:definition "Two sessions are scheduled in the same room at the same time."@en .

fd:NoBreakBetweenSessions a skos:Concept ; skos:inScheme fd:FrictionScheme ; skos:broader fd:ScheduleConflict ;
    skos:prefLabel "No break between sessions"@en ;
    skos:altLabel "no break"@en , "back to back"@en , "back-to-back"@en , "no time for lunch"@en ;
    skos:definition "The schedule leaves no time to move, eat or rest between sessions."@en ;
    skos:related fd:LongWalkingDistances .

fd:ScheduleInformation a skos:Concept ; skos:inScheme fd:FrictionScheme ; skos:broader fd:Schedule ;
    skos:prefLabel "Schedule information"@en ;
    skos:altLabel "schedule info"@en , "agenda info"@en , "event app"@en ;
    skos:definition "The published schedule is wrong, out of date or unavailable."@en .

fd:AppScheduleWrong a skos:Concept ; skos:inScheme fd:FrictionScheme ; skos:broader fd:ScheduleInformation ;
    skos:prefLabel "App schedule wrong"@en ;
    skos:altLabel "app wrong"@en , "app out of date"@en , "sched app wrong"@en , "app shows wrong room"@en , "app crashed"@en , "app not loading"@en ;
    skos:definition "The event app or website shows incorrect or stale schedule data."@en ;
    skos:related fd:RoomChange , fd:WifiOutage .

fd:PrintedScheduleWrong a skos:Concept ; skos:inScheme fd:FrictionScheme ; skos:broader fd:ScheduleInformation ;
    skos:prefLabel "Printed schedule wrong"@en ;
    skos:altLabel "printed agenda wrong"@en , "board wrong"@en , "door sign wrong"@en , "screen schedule wrong"@en ;
    skos:definition "Printed agendas, door signs or display boards disagree with the real schedule."@en ;
    skos:related fd:ConfusingSignage .

#################################################################### Connectivity

fd:Connectivity a skos:Concept ; skos:inScheme fd:FrictionScheme ; skos:topConceptOf fd:FrictionScheme ;
    skos:prefLabel "Connectivity"@en ;
    skos:altLabel "internet"@en , "network"@en , "connection"@en , "online"@en ;
    skos:definition "Problems with Wi-Fi, power or mobile signal."@en .

fd:Wifi a skos:Concept ; skos:inScheme fd:FrictionScheme ; skos:broader fd:Connectivity ;
    skos:prefLabel "Wi-Fi"@en ;
    skos:altLabel "wifi"@en , "wi fi"@en , "wireless"@en , "ssid"@en , "wlan"@en ;
    skos:definition "Problems with the venue wireless network."@en .

fd:WifiOutage a skos:Concept ; skos:inScheme fd:FrictionScheme ; skos:broader fd:Wifi ;
    skos:prefLabel "Wi-Fi outage"@en ;
    skos:altLabel "wifi outage"@en , "wifi down"@en , "wi-fi down"@en , "no internet"@en , "no wifi"@en , "wifi not working"@en , "internet down"@en , "network down"@en , "wifi is down"@en , "wifi was down"@en , "wi-fi is down"@en , "wifi died"@en , "wi-fi dies"@en , "wifi dies"@en , "internet is down"@en ;
    skos:definition "The Wi-Fi network is unavailable."@en .

fd:SlowWifi a skos:Concept ; skos:inScheme fd:FrictionScheme ; skos:broader fd:Wifi ;
    skos:prefLabel "Slow Wi-Fi"@en ;
    skos:altLabel "slow wifi"@en , "slow internet"@en , "wifi slow"@en , "laggy wifi"@en , "wifi keeps dropping"@en , "spotty wifi"@en , "flaky wifi"@en , "wifi is slow"@en , "wifi was slow"@en , "wi-fi is slow"@en , "wifi dropping"@en , "wifi keeps cutting out"@en , "wi-fi keeps cutting out"@en , "wifi cutting out"@en , "wifi is spotty"@en , "wifi is flaky"@en , "wifi unusable"@en , "wifi is unusable"@en , "low bandwidth"@en , "bandwidth"@en , "throughput"@en , "throttled"@en , "slow network"@en ;
    skos:definition "The Wi-Fi works but is slow or intermittent."@en .

fd:WifiLoginProblem a skos:Concept ; skos:inScheme fd:FrictionScheme ; skos:broader fd:Wifi ;
    skos:prefLabel "Wi-Fi login problem"@en ;
    skos:altLabel "wifi password"@en , "wifi password wrong"@en , "captive portal"@en , "can't connect to wifi"@en , "which ssid"@en , "wifi login"@en , "wifi sign-in"@en , "wifi sign in"@en , "wifi login page"@en , "can't log in to wifi"@en , "cannot connect to wifi"@en , "wifi won't connect"@en ;
    skos:definition "Attendees cannot find the network name, password or get past the login page."@en .

fd:Power a skos:Concept ; skos:inScheme fd:FrictionScheme ; skos:broader fd:Connectivity ;
    skos:prefLabel "Power"@en ;
    skos:altLabel "electricity"@en , "charging"@en ;
    skos:definition "Problems charging devices."@en .

fd:NoPowerOutlets a skos:Concept ; skos:inScheme fd:FrictionScheme ; skos:broader fd:Power ;
    skos:prefLabel "No power outlets"@en ;
